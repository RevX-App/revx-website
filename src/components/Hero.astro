---
/**
 * First viewport: headline and actions on the left, one real app screen on the
 * right (a mechanic's swipe card for an owner's post). The garage photo sits
 * behind as a dim backdrop.
 */
import { Image } from 'astro:assets';
import garage from '../assets/garage-hero.png';
import swipe from '../assets/screens/swipe.png';
import Icon from './Icon.astro';
import { APP_URL } from '../config';
---

<section class="hero" id="top">
  <div class="backdrop" aria-hidden="true">
    <Image
      src={garage}
      alt=""
      widths={[640, 1024]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>The mechanic at your door.</h1>
      <p class="lede">
        Tell us what's wrong and get a plain-English read on it. Then compare quotes from San Diego
        mechanics who want the job.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={APP_URL}>Open RevX</a>
        <a class="quiet" href="/mechanics">
          I'm a mechanic <Icon name="arrow" size={18} />
        </a>
      </div>
      <p class="platforms">Runs in your browser today. iOS &amp; Android coming.</p>
    </div>

    <figure class="phone">
      <Image
        src={swipe}
        alt="A mechanic's swipe card for a 2016 Honda Civic post: a photo of the front wheel off, 'Brakes seem to have an issue, where the pads are worn out', tagged Mechanical and This week, with pass, details and interested buttons."
        widths={[320, 480, 640]}
        sizes="(max-width: 1000px) 18rem, 22rem"
        format="webp"
        quality={80}
        loading="eager"
      />
      <figcaption>Screen from the RevX app · demo account</figcaption>
    </figure>
  </div>
</section>

<style>
  /* The garage photo needs a dark ground, so the hero stays dark in both themes. */
  .hero {
    color-scheme: dark;
    background: #000;
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--rule);
  }

  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 0%, #000 50%, transparent 100%);
  }

  .backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    opacity: 0.4; /* 60% black overlay; a lighter one lets the headlight glare break up the headline */
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  h1 {
    font-weight: 800;
    font-size: clamp(3rem, 6vw, 5.5rem);
    letter-spacing: -0.015em;
    line-height: 0.92;
  }

  .lede {
    margin-top: 1.25rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    color: var(--body);
    max-width: 40ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }

  .quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--heading);
  }

  .quiet:hover {
    color: var(--accent-text);
  }

  .platforms {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* The screen sits in a thin bezel, like the app's own phone frame on desktop. */
  .phone {
    margin: 0;
    justify-self: center;
    width: min(100%, 22rem);
  }

  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 1.75rem;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 30px 60px -24px var(--shadow);
  }

  figcaption {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .phone {
      width: min(100%, 18rem);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 2rem;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
