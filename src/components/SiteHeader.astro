---
/**
 * Sticky site nav on the brand's deep green. The current page is marked from the
 * URL (lime + underline + aria-current), so there is no script. At 960px and
 * below the links fold into a menu sheet.
 */
import Mark from '../assets/revx-mark.svg';
import Wordmark from './Wordmark.astro';
import { NAV } from '../nav';
import { APP_URL } from '../config';

// Same normalisation as Base's canonical: build.format 'file' reports /faq.html.
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const current = (href: string) => (href === path ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home" aria-label="RevX home" aria-current={current('/')}>
      <Mark class="mark" aria-hidden="true" />
      <Wordmark size="1.6rem" />
    </a>

    <nav class="links" aria-label="Main">
      <ul>
        {NAV.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
      </ul>
      <a class="btn btn-primary bar-cta" href={APP_URL}>Open RevX</a>
    </nav>

    <details class="menu">
      <summary aria-label="Open menu">
        Menu
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <nav class="menu-sheet" aria-label="Main">
        <ul>
          {NAV.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
        </ul>
        <a class="btn btn-primary" href={APP_URL}>Open RevX</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--brand-deep);
    color: #fff;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }

  .home {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .mark {
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
  }

  /* White "Rev" on the green; the X stays lime. */
  .home :global(.rev) {
    color: #fff;
  }

  .home :global(.x) {
    color: var(--accent);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  ul {
    display: flex;
    gap: clamp(0.25rem, 1.2vw, 1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.2s var(--ease-out);
  }

  ul a:hover,
  ul a[aria-current='page'] {
    color: var(--accent);
  }

  /* Inset underline: marks the page without shifting layout. */
  ul a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .site-header a:focus-visible,
  .site-header summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .bar-cta {
    min-height: 2.75rem;
    font-size: 1rem;
  }

  .menu {
    display: none;
    position: relative;
  }

  @media (max-width: 960px) {
    .links {
      display: none;
    }

    .menu {
      display: block;
    }

    .menu summary {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      padding-inline: 0.9rem;
      border: 1px solid rgb(255 255 255 / 0.25);
      border-radius: 999px;
      list-style: none;
      cursor: pointer;
      color: #fff;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.9375rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .menu summary::-webkit-details-marker {
      display: none;
    }

    .menu-sheet {
      position: absolute;
      right: 0;
      top: calc(100% + 0.6rem);
      width: min(18rem, calc(100vw - 2rem));
      padding: 0.75rem;
      border: 1px solid rgb(255 255 255 / 0.12);
      border-radius: 1.25rem;
      background: var(--brand-deep);
      box-shadow: 0 24px 50px -20px var(--shadow);
    }

    .menu-sheet ul {
      flex-direction: column;
      gap: 0;
      margin-bottom: 0.75rem;
    }

    .menu-sheet ul a {
      font-size: 1.0625rem;
    }

    .menu-sheet .btn {
      width: 100%;
    }
  }
</style>
