---
/**
 * The first real mechanic's quote (story.ts), shared by Our Story and /mechanics.
 * Renders nothing in production until it exists; a dev-only slot marks the gap.
 */
import Placeholder from './Placeholder.astro';
import { story } from '../story';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const q = story.mechanicQuote;
---

{
  q ? (
    <blockquote class:list={['voice', cls]}>
      <p>“{q.quote}”</p>
      <footer>
        {q.name} · {q.shop}
      </footer>
    </blockquote>
  ) : (
    import.meta.env.DEV && (
      <div class={cls}>
        <Placeholder need="First mechanic's quote, with name, shop and their written OK." />
      </div>
    )
  )
}

<style>
  .voice {
    margin: 0;
    max-width: 46rem;
  }

  .voice p {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.1;
    color: var(--heading);
  }

  .voice footer {
    margin-top: 0.75rem;
    color: var(--muted);
  }
</style>
