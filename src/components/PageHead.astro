---
/**
 * Inner-page title band: a car photo behind the brand green, like Home's garage hero.
 * The photo is grayscaled, tinted green and darkened toward the text side for contrast.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  lede?: string;
  photo: ImageMetadata;
  focus?: string; // object-position: where the car sits in the photo
}

const { title, lede, photo, focus = '50% 58%' } = Astro.props;
---

<div class="page-head">
  <div class="backdrop" aria-hidden="true">
    <Image src={photo} alt="" widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, min(55vw, 48rem)" format="webp" quality={70} loading="eager" style={`object-position: ${focus}`} />
  </div>
  <div class="wrap">
    <h1>{title}</h1>
    {lede && <p>{lede}</p>}
  </div>
</div>

<style>
  .page-head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--brand-deep);
    color: #fff;
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  /* The photo sits on the right, wide enough to show the whole car, fading into the green. */
  .backdrop {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(55%, 48rem);
    z-index: -1;
    isolation: isolate;
    mask-image: linear-gradient(90deg, transparent 0%, #000 40%);
  }

  .backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15) brightness(1.1);
    opacity: 0.7;
  }

  /* Green hue: brand green laid over the grayscale photo in color mode. */
  .backdrop::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #2f6f5f;
    mix-blend-mode: color;
  }

  /* Darken the bottom edge so the band sits on the page. */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to bottom, rgb(23 44 41 / 0.15) 0%, rgb(23 44 41 / 0.55) 100%);
  }

  /* Phones: the photo goes full width behind the text, darker so the title reads. */
  @media (max-width: 760px) {
    .backdrop {
      width: 100%;
      mask-image: none;
    }

    .backdrop img {
      opacity: 0.35;
    }
  }

  h1 {
    color: #fff;
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }

  p {
    margin-top: 1rem;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    color: rgb(255 255 255 / 0.85);
  }
</style>
