---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import mustangHero from '../assets/heroes/mustang-hero.jpg';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import swipe from '../assets/screens/swipe.png';
import { APP_URL, PHONE, MECHANIC_PITCH as pitch } from '../config';
import MechanicQuote from '../components/MechanicQuote.astro';
// Approved 2026-11-24: marketing's four angles, each limited to what the app does today.
const mechSpec = [
  { name: 'Earnings', body: 'Keep 100% of your quotes during launch. You set the price in your quote; the owner pays you directly.' },
  { name: 'Flexibility', body: "Pick only the jobs that fit your skills and how far you'll travel. You agree on every time slot." },
  { name: 'Customers', body: "Drivers near you post real problems, with photos and the AI's first look at the cause. Match, and you get a technical briefing before you quote." },
  { name: 'Fair access', body: 'No lead fees, no pay-to-rank. Every mechanic quotes on the same terms.' },
];

// Approved 2026-11-25: what happens after tapping Join, in plain words.
const joinSteps = [
  'Sign up in your browser, no download.',
  "Add your shop, your skills and how far you'll travel.",
  'A founder checks your details and gets in touch.',
];

---

<Base title="For mechanics" description="Pick the San Diego repair jobs that fit your skills and how far you'll travel. Free to join, no lead fees, and you keep 100% of your quotes during launch.">
  <PageHead title={pitch.headline.join(' ')} lede={pitch.support} photo={mustangHero} focus="50% 61%" />
  <main>
    <!-- 3. Mechanics -->
    <section id="mechanics">
      <div class="wrap split">
        <div>
          <dl class="spec">
            {
              mechSpec.map((row) => (
                <div>
                  <dt>{row.name}</dt>
                  <dd>{row.body}</dd>
                </div>
              ))
            }
          </dl>
          <MechanicQuote class="quote" />
          <h2 class="join-head">How to join</h2>
          <ol class="join-steps">
            {joinSteps.map((s) => <li>{s}</li>)}
          </ol>
          <div class="founding">
            <p class="founding-head">The first 100 mechanics get founding status and the best terms we ever offer.</p>
            <p>
              We're hand-recruiting independent mobile mechanics, students who wrench on the side, and
              small shops across San Diego.
            </p>
            <a class="btn btn-primary" href={APP_URL}>
              {pitch.cta} <Icon name="arrow" size={18} />
            </a>
            <p class="founding-note">{pitch.note}</p>
            <p class="founding-note">
              Questions? Call or text <a href={`tel:${PHONE.tel}`}>{PHONE.display}</a>
            </p>
          </div>
        </div>

        <figure class="display">
          <Image
            src={swipe}
            alt="A mechanic's swipe card for a 2016 Honda Civic post: a photo of the front wheel off, 'Brakes seem to have an issue, where the pads are worn out', tagged Mechanical and This week, with pass, details and interested buttons."
            widths={[320, 480, 640]}
            sizes="(max-width: 1000px) 18rem, 22rem"
            format="webp"
            quality={80}
          />
          <figcaption>What you see: an owner's post, from the RevX app · demo account</figcaption>
        </figure>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Mechanics */
  .spec {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .spec div {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .spec dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--heading);
  }

  .spec dd {
    margin: 0;
    color: var(--body);
  }

  .mechanics :global(.quote) {
    margin-top: 2rem;
  }

  .join-head {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .join-steps {
    margin: 0;
    padding-left: 1.5rem;
    display: grid;
    gap: 0.6rem;
    color: var(--body);
    font-size: 1.125rem;
  }

  .join-steps li::marker {
    color: var(--accent-text);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .founding {
    margin-top: 2.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 1.25rem;
    border: 1px solid var(--accent-text);
    background: var(--accent-wash);
    display: grid;
    gap: 0.8rem;
    justify-items: start;
  }

  .founding-head {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1.05;
    color: var(--heading);
  }

  .founding p:not(.founding-head) {
    color: var(--body);
    max-width: 56ch;
  }

  .display {
    position: sticky;
    top: 6rem;
    margin: 0;
    justify-self: center;
    width: min(100%, 22rem);
  }

  .display img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 1.75rem;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 30px 60px -24px var(--shadow);
  }

  .display figcaption {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .founding-note {
    font-size: 0.9375rem;
  }

  @media (max-width: 1000px) {
    .display {
      position: static;
      width: min(100%, 18rem);
    }
  }

  @media (max-width: 640px) {
    .spec div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
