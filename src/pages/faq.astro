---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { faq } from '../faq';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<Base title="FAQ" description="Straight answers about how RevX works for car owners and mechanics in San Diego." schema={schema}>
  <PageHead title="FAQ" lede="Straight answers about how RevX works for owners and mechanics." />
  <main>
    <!-- FAQ: direct answers, mirrored in FAQPage markup -->
    <section id="faq">
      <div class="wrap">
        <dl class="faq">
          {
            faq.map(({ q, a }) => (
              <div>
                <dt>{q}</dt>
                <dd>{a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </main>
</Base>

<style>
  /* FAQ */
  .faq {
    max-width: 48rem;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .faq div {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .faq dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--heading);
  }

  .faq dd {
    margin: 0.5rem 0 0;
    color: var(--body);
    max-width: 62ch;
  }
</style>
