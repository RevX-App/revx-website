---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import bmwHero from '../assets/heroes/bmw-hero.avif';
import { faq } from '../faq';

const groups = [
  { id: 'trust', title: 'Trust & safety', items: faq.filter((f) => f.group === 'trust') },
  { id: 'more', title: 'Everything else', items: faq.filter((f) => f.group === 'other') },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<Base title="FAQ" description="Straight answers about how RevX works for car owners and mechanics in San Diego." schema={schema}>
  <PageHead title="FAQ" lede="Straight answers about how RevX works for owners and mechanics." photo={bmwHero} focus="50% 40%" />
  <main>
    <!-- FAQ: direct answers in two groups, all mirrored in FAQPage markup -->
    {
      groups.map((g) => (
        <section id={g.id}>
          <div class="wrap">
            <h2>{g.title}</h2>
            <dl class="faq">
              {g.items.map(({ q, a }) => (
                <div>
                  <dt>{q}</dt>
                  <dd>{a}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      ))
    }
  </main>
</Base>

<style>
  /* FAQ */
  h2 {
    margin-bottom: 1.25rem;
  }

  .faq {
    max-width: 48rem;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .faq div {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .faq dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--heading);
  }

  .faq dd {
    margin: 0.5rem 0 0;
    color: var(--body);
    max-width: 62ch;
  }
</style>
