---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import mazdaHero from '../assets/heroes/mazda-hero.avif';
import Portrait from '../components/Portrait.astro';
import Placeholder from '../components/Placeholder.astro';
import BranchGraph from '../components/BranchGraph.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { team } from '../team';
import OrgChart from '../components/OrgChart.astro';
import { story } from '../story';
---

<Base title="Our story" description="RevX.website is built by five UC San Diego students who learned the hard way that there were better options than the mechanic they went to.">
  <PageHead title="Our story" lede="RevX.website started at UC San Diego. The app is open today, and we're signing up local mechanics around campus first." photo={mazdaHero} focus="50% 50%" />
  <main>
    <!-- Group photo: founders supply it -->
    {
      story.groupPhoto ? (
        <section class="group">
          <div class="wrap">
            <Image class="group-photo" src={story.groupPhoto.src} alt={story.groupPhoto.alt} widths={[640, 1024, 1600]} sizes="(max-width: 1360px) 100vw, 82rem" format="webp" quality={78} />
          </div>
        </section>
      ) : (
        import.meta.env.DEV && (
          <section class="group">
            <div class="wrap">
              <Placeholder need="Team group photo, landscape, on campus or with a car." />
            </div>
          </section>
        )
      )
    }

    <!-- Why we started: the founder's own reason -->
    <section id="why">
      <div class="wrap">
        <header class="sec-head">
          <h2>Why we started</h2>
        </header>
      </div>
      <!-- Heading on its own row, so the photo and the story start on the same line. -->
      <div class:list={['wrap', { split: story.founderCar || import.meta.env.DEV }]}>
        <div>
          {
            story.founderCar ? (
              <Image class="car" src={story.founderCar.src} alt={story.founderCar.alt} widths={[480, 800, 1200]} sizes="(max-width: 1000px) 100vw, 40rem" format="webp" quality={78} />
            ) : (
              <Placeholder need="Photo of Mustaqim's broken car (the $4,000 suspension)." />
            )
          }
        </div>
        <div class="prose">
          <p>
            We've all had a bad experience with a mechanic, and found out too late that there were better options nearby. We built RevX.website so the next person doesn't have to learn that the hard way.
          </p>
          {
            story.founderNote && (
              <blockquote class="note">
                {story.founderNote.text.map((t) => <p>{t}</p>)}
                <footer>{story.founderNote.by}</footer>
              </blockquote>
            )
          }
          <p>So we're starting where we are: with mechanics around UC San Diego, and the students and neighbors who need them.</p>
        </div>
      </div>
    </section>

    <!-- How we're building it: the consent principle and the honesty rule -->
    <section id="how">
      <div class="wrap">
        <header class="sec-head">
          <h2>How we're building it</h2>
        </header>
        <div class="prose">
          <p>We talk all the time as a team: on Discord, on Google Meet and in person.</p>
          <p>
            Consent is the rule. You and your mechanic both choose the match, both agree to the job, both confirm it's done, and both leave a review.
          </p>
          <p>And we only tell you about what the app does today. Anything still in the works, we say so.</p>
        </div>
        {
          story.behindTheScenes ? (
            <Image class="bts" src={story.behindTheScenes.src} alt={story.behindTheScenes.alt} widths={[640, 1200, 2000]} sizes="(max-width: 1360px) 100vw, 82rem" format="webp" quality={78} />
          ) : (
            <Placeholder need="Behind-the-scenes photo: the team at work, or with a mechanic." />
          )
        }
      </div>
    </section>

    <!-- So far: real, dated milestones on the same git-style graph as Home -->
    <section id="so-far">
      <div class="wrap">
        <header class="sec-head">
          <h2>So far</h2>
        </header>
        <BranchGraph stops={story.milestones} />
      </div>
    </section>

    <!-- The team as an org chart: founders on top, the crew branching below -->
    <section id="team">
      <div class="wrap">
        <header class="sec-head">
          <h2>The team</h2>
        </header>
        <OrgChart label="The RevX.website team" portrait={5} stack>
          {(f: (typeof team)[number]) => (
            <>
              <Portrait person={f} />
              <h3 class="crew-name">{f.name}</h3>
              <p class="crew-title">
                {f.title} · {f.study}
              </p>
              <p class="crew-line">{f.line}</p>
              <p class="crew-links">
                {f.linkedin && (
                  <a href={f.linkedin} aria-label={`${f.name} on LinkedIn`}>
                    LinkedIn
                  </a>
                )}
                {f.site && (
                  <a href={f.site} aria-label={`${f.name}'s website`}>
                    {new URL(f.site).hostname}
                  </a>
                )}
              </p>
            </>
          )}
        </OrgChart>
      </div>
    </section>

    <!-- Who's helped us: real supporters only (no press yet; see story.ts) -->
    <section id="helped">
      <div class="wrap">
        <header class="sec-head">
          <h2>Who's helped us</h2>
        </header>
        <ul class="helpers">
          {
            story.helpers.map((h) => (
              <li>
                {h.logo ? (
                  <span class="helper-logo">
                    <Image src={h.logo} alt="" width={72} height={72} densities={[1, 2]} format="webp" />
                  </span>
                ) : (
                  <Placeholder need={`${h.name} logo, square image.`} />
                )}
                <span class="helper-name">{h.url ? <a href={h.url}>{h.name}</a> : h.name}</span>
                <span class="helper-what">{h.what}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Close: two ways to help -->
    <section id="join">
      <div class="wrap">
        <header class="sec-head">
          <h2>Want to help?</h2>
        </header>
        <ul class="ways">
          <li>
            <a href="/mechanics">
              <span class="way-name">You fix cars</span>
              <span class="way-go">Join as a founding mechanic <Icon name="arrow" size={18} /></span>
            </a>
          </li>
          <li>
            <a href="/contact#investors">
              <span class="way-name">Investing, press or partners</span>
              <span class="way-go">Email the founders <Icon name="arrow" size={18} /></span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>
</Base>

<style>
  .bts {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  #so-far {
    --graph-ground: var(--bg);
  }

  .car {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 60% 55%; /* keep the car and the lift in frame */
  }

  .group-photo,
  .bts,
  .car {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.5rem;
    border: 1px solid var(--rule-strong);
  }

  .prose {
    display: grid;
    gap: 1rem;
    max-width: 62ch;
    color: var(--body);
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
  }

  .note {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent-text);
    display: grid;
    gap: 0.75rem;
  }

  .note footer {
    color: var(--muted);
    font-family: var(--font-display);
    font-weight: 600;
  }

  /* The team: card contents; OrgChart draws the lines. */
  .crew-name {
    margin-top: 0.9rem;
    font-size: 1.625rem;
  }

  .crew-title {
    color: var(--muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .crew-line {
    color: var(--body);
    max-width: 32ch;
    margin-top: 0.75rem;
  }

  .crew-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.25rem;
    margin-top: 0.3rem;
  }

  .crew-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* Who's helped us: supporters side by side, logo over name over what they did. */
  .helpers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
  }

  .helpers li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-strong);
  }

  /* Logos sit in a squircle: a rounded square, true superellipse where corner-shape is supported. */
  .helper-logo {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 0.75rem;
    border-radius: 28%;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
  }

  @supports (corner-shape: squircle) {
    .helper-logo {
      border-radius: 50%;
      corner-shape: squircle;
    }
  }

  .helper-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .helper-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--heading);
  }

  .helper-what {
    color: var(--body);
    max-width: 36ch;
  }

  /* Want to help: two rows, the whole row is the link. */
  .ways {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .ways a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    min-height: 4.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .way-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    color: var(--heading);
  }

  .way-go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-text);
    font-weight: 600;
  }

  .ways a:hover .way-go {
    text-decoration: underline;
  }

</style>
