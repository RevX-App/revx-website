---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { APP_URL, SITE, PHONE, MECHANIC_PITCH as pitch } from '../config';
import { team } from '../team';
import Portrait from '../components/Portrait.astro';
import { Image } from 'astro:assets';
import { faq, homeFaq } from '../faq';
import diagnosis from '../assets/screens/diagnosis.png';
import quote from '../assets/screens/quote.png';
import confirm from '../assets/screens/confirm.png';

// Copy approved 2026-11-24: two sentences per step, each tied to a real app screen.
const journey = [
  {
    name: 'Snap & Diagnose',
    body: "Answer the questions a mechanic would ask, add a photo, and record the noise if you like. You get a plain-English read: likely causes, how urgent it is, and a rough cost range.",
    note: 'AI-generated from your photos and answers. Not a substitute for a hands-on inspection.',
    screen: diagnosis,
    alt: "The app's AI diagnosis for a 2016 Honda Civic: most likely worn front brake pads, high severity, urgent, book this week, $150 to $350, with a plain-English explanation.",
  },
  {
    name: 'Match & Compare',
    body: 'Mechanics who want the job swipe on your post, and you choose who you trust. Chat, compare quotes, and agree on a price and a time together.',
    screen: quote,
    alt: 'An itemized estimate from a mechanic: front pad replacement labor $135 and front ceramic brake pads $65, total $200, with Approve, Request changes and Decline buttons.',
    wide: true,
  },
  {
    name: 'Get Fixed & Review',
    body: "Meet where you agreed, at your place or their shop, and you both confirm when the job's done. Then you review each other, and neither side sees the other's review until both are in.",
    screen: confirm,
    alt: "A chat in the app after the appointment: the mechanic says the work is complete, and the owner's next step is a Confirm it is fixed button.",
  },
];

// Approved 2026-11-24: only mechanisms that run in the app today.
// Bodies come from the /faq trust answers so the two can't drift.
const answer = (id: string) => faq.find((f) => f.id === id)!.a;
const trust: { icon: IconName; name: string; body: string }[] = [
  { icon: 'check', name: 'Mechanics are verified', body: answer('vetting') },
  { icon: 'job', name: 'Quotes you can read', body: answer('quotes') },
  { icon: 'match', name: 'Nothing happens without both of you', body: answer('consent') },
  { icon: 'review', name: 'Reviews you can believe', body: answer('reviews') },
  { icon: 'bell', name: 'Payment and problems', body: answer('problems') },
];

// Revised 2026-11-25. No dates; a stop is marked done only when it's actually running.
// A git-style graph: the apps branch off "App live" (fork), run alongside mechanic sign-ups
// (parallel), and merge into the San Diego launch. `col` is the desktop column.
const stops: {
  name: string;
  body: string;
  state: 'done' | 'now' | 'next' | 'later';
  col: number;
  lane: 'main' | 'branch';
  fork?: boolean;
  parallel?: boolean;
  last?: boolean;
}[] = [
  { name: 'App live in your browser', body: 'Post a problem, match and book at revx.website today.', state: 'done', col: 1, lane: 'main', fork: true },
  { name: 'Signing up mechanics', body: "We're onboarding founding mechanics around UC San Diego.", state: 'now', col: 2, lane: 'main', parallel: true },
  { name: 'iOS & Android apps', body: 'Built alongside mechanic sign-ups, ready for the San Diego launch.', state: 'now', col: 2, lane: 'branch' },
  { name: 'Launch in the San Diego area', body: 'Starting with UCSD and La Jolla, then the rest of the city.', state: 'next', col: 3, lane: 'main' },
  { name: 'Launch across SoCal', body: 'More of Southern California.', state: 'later', col: 4, lane: 'main', last: true },
];
const stateLabel = { done: 'Done', now: 'Now', next: 'Next', later: 'Later' };

const UCSD = { '@type': 'CollegeOrUniversity', name: 'University of California San Diego', url: 'https://ucsd.edu' };

// Everyone is a current student, so UCSD is an affiliation, not alumniOf.
const person = (f: (typeof team)[number]) => ({
  '@type': 'Person',
  name: f.name,
  jobTitle: f.title,
  description: f.line,
  ...((f.linkedin || f.site) && { sameAs: [f.linkedin, f.site].filter(Boolean) }),
  affiliation: UCSD,
});

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#org', Astro.site).href,
    name: 'RevX.website',
    alternateName: ['RevX.website', 'RevX.website car repair'],
    url: new URL('/', Astro.site).href,
    logo: new URL('/icon-512.png', Astro.site).href,
    description: SITE.description,
    areaServed: { '@type': 'City', name: 'San Diego', containedInPlace: { '@type': 'State', name: 'California' } },
    foundingLocation: { '@type': 'Place', name: 'San Diego, California' },
    sameAs: ['https://github.com/RevX-App'],
    founder: team.filter((f) => /found/i.test(f.title)).map(person),
    employee: team.filter((f) => !/found/i.test(f.title)).map(person),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RevX.website',
    url: new URL('/', Astro.site).href,
    publisher: { '@id': new URL('/#org', Astro.site).href },
  },
];

---

<Base schema={schema}>
  <script is:inline>
    // Old one-page anchors (shared before the site split) land on their new pages.
    {
      const to = { how: '/how-it-works', mechanics: '/mechanics', about: '/our-story', contact: '/contact', faq: '/faq' }[location.hash.slice(1)];
      if (to) location.replace(to);
    }
  </script>
  <Hero />

  <main>
    <!-- Customer journey: three steps, each with a real app screen -->
    <section id="journey">
      <div class="wrap">
        <header class="sec-head">
          <h2>From a strange noise to a fixed car.</h2>
        </header>
        <ol class="journey">
          {
            journey.map((step, i) => (
              <li class="step">
                <div class="step-copy">
                  <p class="step-num" aria-hidden="true">{i + 1}</p>
                  <h3>{step.name}</h3>
                  <p>{step.body}</p>
                  {step.note && <p class="step-note">{step.note}</p>}
                </div>
                <figure class:list={['step-screen', { wide: step.wide }]}>
                  <Image src={step.screen} alt={step.alt} widths={step.wide ? [480, 720, 960] : [320, 480, 640]} sizes={step.wide ? '(max-width: 1000px) 100vw, 34rem' : '(max-width: 1000px) 18rem, 20rem'} format="webp" quality={80} />
                </figure>
              </li>
            ))
          }
        </ol>
        <p class="screens-note">Screens from the app · demo accounts</p>
      </div>
    </section>

    <!-- Practical questions, from the same list as /faq -->
    <section id="questions">
      <div class="wrap">
        <header class="sec-head">
          <h2>The practical bits.</h2>
        </header>
        <dl class="qa">
          {
            homeFaq.map(({ q, a }) => (
              <div>
                <dt>{q}</dt>
                <dd>{a}</dd>
              </div>
            ))
          }
        </dl>
        <p class="more"><a href="/faq">More questions</a></p>
      </div>
    </section>

    <!-- Why trust RevX: who's behind it, then the mechanisms that run today -->
    <section id="trust">
      <div class="wrap split trust">
        <div>
          <header class="sec-head">
            <h2>Why trust RevX.website?</h2>
            <p class="lede">
              We're five UC San Diego students. We've had bad experiences with mechanics ourselves, and found out too late there were better options. RevX.website is how we help you avoid that.
            </p>
            <p class="lede">We're starting with our own campus, and a founder reads every message you send.</p>
          </header>
          <ul class="team" aria-label="The RevX.website team">
            {
              team.map((f) => (
                <li>
                  <Portrait person={f} size={3.5} />
                  <span class="team-name">{f.name}</span>
                  <span class="team-role">{f.title}</span>
                </li>
              ))
            }
          </ul>
          <p class="more"><a href="/our-story">Meet the team</a></p>
        </div>

        <div>
          <ul class="lamps">
            {
              trust.map((t) => (
                <li>
                  <span class="lit" aria-hidden="true"><Icon name={t.icon} size={20} /></span>
                  <div>
                    <h3>{t.name}</h3>
                    <p>{t.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="more"><a href="/faq#trust">How we handle trust</a></p>
        </div>
      </div>
    </section>

    <!-- Mechanic recruitment: the one full-lime band on the site -->
    <section class="mech-cta" id="for-mechanics">
      <div class="wrap mech-inner">
        <div>
          <h2>
            <span>{pitch.headline[0]}</span>
            <span>{pitch.headline[1]}</span>
          </h2>
          <p class="mech-support">{pitch.support}</p>
        </div>
        <div class="mech-actions">
          <a class="btn mech-join" href={APP_URL}>
            {pitch.cta} <Icon name="arrow" size={18} />
          </a>
          <p class="mech-note">{pitch.note}</p>
          <p class="mech-note">
            Questions? Call or text <a class="mech-tel" href={`tel:${PHONE.tel}`}>{PHONE.display}</a>
          </p>
          <a class="mech-more" href="/mechanics">How RevX.website works for mechanics</a>
        </div>
      </div>
    </section>

    <!-- Progress strip: where RevX actually is -->
    <section id="progress" class="vision">
      <div class="wrap">
        <header class="sec-head">
          <h2>Where we're at.</h2>
          <p class="lede">We'll mark a stop done only when it's actually running.</p>
        </header>
        <ol class="graph">
          {
            stops.map((m) => (
              <li
                class:list={[m.state, m.lane, { fork: m.fork, parallel: m.parallel, last: m.last }]}
                style={`--col: ${m.col}`}
                aria-current={m.state === 'now' && m.lane === 'main' ? 'step' : undefined}
              >
                <span class="rail" aria-hidden="true">
                  <span class="stop">
                    {m.state === 'done' && <Icon name="check" size={18} />}
                    {m.state === 'now' && <Icon name="pin" size={18} />}
                  </span>
                </span>
                <span class="label">
                  <span class="stop-name">{m.name}</span>
                  <span class="stop-state">{stateLabel[m.state]}</span>
                  <span class="stop-body">{m.body}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 6. Close -->
    <section class="close">
      <div class="wrap close-inner">
        <div>
          <h2>Your car's telling you something.</h2>
          <p class="lede">Find out what, and who should fix it. Runs in your browser today; iOS and Android are coming.</p>
        </div>
        <div class="close-actions">
          <a class="start" href={APP_URL}>
            <span class="start-main">Open</span>
            <span class="start-sub">RevX<span class="start-tld">.website</span></span>
          </a>
        </div>
      </div>
    </section>
  </main>

</Base>

<style>
  /* Journey: copy and screen side by side, alternating sides down the page. */
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .step:nth-child(even) .step-copy {
    order: 2;
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
  }

  .step-copy p:not(.step-num) {
    margin-top: 0.75rem;
    max-width: 44ch;
    color: var(--body);
    font-size: 1.125rem;
  }

  .step-copy .step-note {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .step-screen {
    margin: 0;
    justify-self: center;
    width: min(100%, 20rem);
  }

  .step-screen.wide {
    width: min(100%, 34rem);
  }

  .step-screen img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 1.5rem;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 24px 36px -24px var(--shadow);
  }

  .screens-note {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* Practical questions */
  .qa {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr)); /* 4 questions: 2 columns, never an orphan */
    gap: 1.5rem 3rem;
  }

  .qa div {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .qa dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--heading);
  }

  .qa dd {
    margin: 0.5rem 0 0;
    color: var(--body);
  }

  .more {
    margin-top: 2rem;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* Why trust RevX: the team, then the lamps that are lit today. */
  .trust {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  @media (max-width: 1000px) {
    .trust {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: 1.5rem 1.25rem;
  }

  .team li {
    display: grid;
    justify-items: start;
    gap: 0.15rem;
  }

  .team :global(.portrait) {
    margin-bottom: 0.5rem;
  }

  .team-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.15;
    color: var(--heading);
  }

  .team-role {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .lamps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .lamps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--rule);
  }

  .lamps h3 {
    font-size: 1.375rem;
    line-height: 1.15;
  }

  .lamps p {
    margin-top: 0.4rem;
    color: var(--body);
    max-width: 58ch;
  }

  /* Lit lamps: these run today. */
  .lit {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--accent-text);
    color: var(--accent-text);
  }

  /* Mechanic CTA: lime ground, near-black ink, inverted button. */
  .mech-cta {
    background: var(--accent);
    color: var(--on-accent);
  }

  .mech-cta :focus-visible {
    outline-color: var(--on-accent);
  }

  .mech-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }

  .mech-cta h2 {
    color: var(--on-accent);
    line-height: 0.95;
  }

  .mech-cta h2 span {
    display: block;
  }

  .mech-support {
    margin-top: 1.25rem;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
  }

  .mech-actions {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .mech-join {
    background: var(--on-accent);
    color: var(--accent);
  }

  .mech-note {
    font-size: 0.9375rem;
  }

  .mech-tel,
  .mech-tel:hover {
    color: var(--on-accent);
    font-weight: 700;
  }

  .mech-more,
  .mech-more:hover {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--on-accent);
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .mech-inner {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Progress strip */
  .vision {
    background: var(--sand);
  }

  /* Graph: main line on top, the apps branch below, git-style. Solid = travelled, dashed = ahead. */
  .graph {
    --stop: 2.75rem;
    --band: 8rem; /* rail row: main stops at its top, the branch stop lower down */
    --branch-y: 4.75rem; /* top of the branch stop inside the band */
    --wire: 1.5px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .label {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .rail::before,
  .rail::after {
    content: '';
    position: absolute;
    border: 0 dashed var(--unlit);
  }

  /* Desktop geometry only, so none of it leaks into the vertical phone graph. */
  @media (min-width: 1001px) {
  .graph {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto var(--band) auto;
  }

  .graph li {
    display: grid;
    grid-template-rows: subgrid;
    grid-column: var(--col);
    padding-right: 1.5rem;
  }

  .graph li.main {
    grid-row: 1 / 3;
  }

  .graph li.branch {
    grid-row: 2 / 4;
  }

  .graph li.main .label {
    grid-row: 1;
    padding-bottom: 1.25rem;
  }

  .graph li.main .rail {
    grid-row: 2;
  }

  .graph li.branch .rail {
    grid-row: 1;
  }

  .graph li.branch .label {
    grid-row: 2;
  }

  /* The rail spans the full column (into the padding) so wires reach the next stop. */
  .rail {
    position: relative;
    margin-right: -1.5rem;
  }

  .branch .stop {
    margin-top: var(--branch-y);
  }

  .branch .label {
    padding-top: 0.75rem;
  }

  /* Main wire to the next main stop. */
  .main:not(.last) .rail::after {
    top: calc(var(--stop) / 2);
    left: var(--stop);
    right: 0;
    border-top-width: var(--wire);
  }

  .main.done .rail::after {
    border-top-style: solid;
    border-color: var(--accent-text);
  }

  /* Fork: down from App live, then right into the branch stop. */
  .fork .rail::before {
    top: var(--stop);
    left: calc(var(--stop) / 2);
    width: calc(100% - var(--stop) / 2);
    height: calc(var(--branch-y) - var(--stop) / 2);
    border-left-width: var(--wire);
    border-bottom-width: var(--wire);
    border-bottom-left-radius: 1rem;
    border-color: var(--accent-text);
  }

  /* Merge: right from the branch stop, then up into the San Diego launch. */
  .branch .rail::after {
    top: calc(var(--stop) / 2);
    left: var(--stop);
    width: calc(100% - var(--stop) / 2);
    height: var(--branch-y);
    border-right-width: var(--wire);
    border-bottom-width: var(--wire);
    border-bottom-right-radius: 1rem;
    border-color: var(--accent-text);
  }
  }

  .stop {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--stop);
    height: var(--stop);
    border-radius: 50%;
    border: var(--wire) dashed var(--unlit);
    background: var(--sand);
  }

  .done .stop {
    border: var(--wire) solid var(--accent-text);
    color: var(--accent-text);
  }

  .now .stop {
    border: var(--wire) solid var(--accent-text);
    background: var(--accent);
    color: var(--on-accent);
  }

  .stop-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.1;
    color: var(--heading);
  }

  .next .stop-name,
  .later .stop-name {
    color: var(--muted);
  }

  .stop-body {
    margin-top: 0.25rem;
    color: var(--body);
    max-width: 26ch;
  }

  .stop-state {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .now .stop-state {
    color: var(--accent-text);
  }

  /* Close */
  .close {
    background: radial-gradient(ellipse at 80% 130%, var(--accent-wash), transparent 60%);
  }

  .close-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem 4rem;
  }

  .close h2 {
    font-size: clamp(2.5rem, 5.5vw, 5rem);
  }

  .close-actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  @media (max-width: 1000px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
    }

    .step:nth-child(even) .step-copy {
      order: 0;
    }

    .close-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The graph turns vertical, like git log --graph: main rail left, branch rail beside it. */
    .graph {
      --lane: calc(var(--stop) + 1rem); /* branch rail offset */
      grid-template-columns: minmax(0, 1fr);
    }

    .graph li {
      position: relative;
      display: grid;
      grid-template-columns: calc(var(--stop) + var(--lane)) minmax(0, 1fr);
      column-gap: 0.75rem;
      padding: 0 0 1.75rem;
    }

    .branch .stop {
      margin: 0 0 0 var(--lane);
    }


    /* Main rail down to the next stop; the branch row lets it pass through. */
    .main:not(.last) .rail::after,
    .branch .rail::after {
      top: var(--stop);
      bottom: 0;
      left: calc(var(--stop) / 2);
      width: 0;
      border-top-width: 0;
      border-right-width: 0;
      border-bottom-width: 0;
      border-left-width: var(--wire);
      border-left-style: dashed;
      border-color: var(--unlit);
    }

    .branch .rail::after {
      top: 0;
    }

    .main.done .rail::after {
      border-left-style: solid;
      border-color: var(--accent-text);
    }

    /* Fork: right from App live, then down the branch rail. */
    .fork .rail::before {
      top: calc(var(--stop) / 2);
