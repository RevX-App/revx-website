---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { APP_URL, SITE } from '../config';
import { founders } from '../founders';
import { Image } from 'astro:assets';
import { homeFaq } from '../faq';
import diagnosis from '../assets/screens/diagnosis.png';
import quote from '../assets/screens/quote.png';
import confirm from '../assets/screens/confirm.png';

// Copy approved 2026-11-24: two sentences per step, each tied to a real app screen.
const journey = [
  {
    name: 'Snap & Diagnose',
    body: "Answer the questions a mechanic would ask, add a photo, and record the noise if you like. You get a plain-English read: likely causes, how urgent it is, and a rough cost range.",
    note: 'AI-generated from your photos and answers. Not a substitute for a hands-on inspection.',
    screen: diagnosis,
    alt: "RevX's AI diagnosis for a 2016 Honda Civic: most likely worn front brake pads, high severity, urgent, book this week, $150 to $350, with a plain-English explanation.",
  },
  {
    name: 'Match & Compare',
    body: 'Mechanics who want the job swipe on your post, and you choose who you trust. Chat, compare quotes, and agree on a price and a time together.',
    screen: quote,
    alt: 'An itemized estimate from a mechanic: front pad replacement labor $135 and front ceramic brake pads $65, total $200, with Approve, Request changes and Decline buttons.',
    wide: true,
  },
  {
    name: 'Get Fixed & Review',
    body: "Meet where you agreed, at your place or their shop, and you both confirm when the job's done. Then you review each other, and neither side sees the other's review until both are in.",
    screen: confirm,
    alt: "A RevX chat after the appointment: the mechanic says the work is complete, and the owner's next step is a Confirm it is fixed button.",
  },
];

const roadmap: { icon: IconName; name: string }[] = [
  { icon: 'payments', name: 'Payments & escrow' },
  { icon: 'verified', name: 'Verified mechanics' },
  { icon: 'obd', name: 'OBD-II fault codes' },
  { icon: 'vin', name: 'VIN scanner' },
  { icon: 'photo', name: 'Photo messages' },
  { icon: 'insurance', name: 'Insurance' },
  { icon: 'ebike', name: 'E-bikes & scooters' },
  { icon: 'pro', name: 'Pro plans' },
];

// Milestones are a separate route from the feature lamps: no feature is promised to a stop.
const milestones: { name: string; state: 'done' | 'now' | 'next' }[] = [
  { name: 'Pitching', state: 'done' },
  { name: 'Soft test', state: 'now' },
  { name: 'Promotion', state: 'next' },
  { name: 'Launch on App Store & Google Play', state: 'next' },
  { name: 'Beyond San Diego', state: 'next' },
];
const stateLabel = { done: 'Done', now: 'Now', next: 'Next' };

const UCSD = { '@type': 'CollegeOrUniversity', name: 'University of California San Diego', url: 'https://ucsd.edu' };

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#org', Astro.site).href,
    name: 'RevX',
    alternateName: ['RevX car repair', 'RevX app'],
    url: new URL('/', Astro.site).href,
    logo: new URL('/icon-512.png', Astro.site).href,
    description: SITE.description,
    areaServed: { '@type': 'City', name: 'San Diego', containedInPlace: { '@type': 'State', name: 'California' } },
    foundingLocation: { '@type': 'Place', name: 'San Diego, California' },
    sameAs: ['https://github.com/RevX-App'],
    founder: founders.map((f) => ({
      '@type': 'Person',
      name: f.name,
      jobTitle: f.title,
      description: f.line,
      sameAs: [f.linkedin, f.site].filter(Boolean),
      alumniOf: UCSD,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RevX',
    url: new URL('/', Astro.site).href,
    publisher: { '@id': new URL('/#org', Astro.site).href },
  },
];

---

<Base schema={schema}>
  <script is:inline>
    // Old one-page anchors (shared before the site split) land on their new pages.
    {
      const to = { how: '/how-it-works', trust: '/how-it-works#trust', mechanics: '/mechanics', about: '/our-story', contact: '/contact', faq: '/faq' }[location.hash.slice(1)];
      if (to) location.replace(to);
    }
  </script>
  <Hero />

  <main>
    <!-- Customer journey: three steps, each with a real app screen -->
    <section id="journey">
      <div class="wrap">
        <header class="sec-head">
          <h2>From a strange noise to a fixed car.</h2>
        </header>
        <ol class="journey">
          {
            journey.map((step, i) => (
              <li class="step">
                <div class="step-copy">
                  <p class="step-num" aria-hidden="true">{i + 1}</p>
                  <h3>{step.name}</h3>
                  <p>{step.body}</p>
                  {step.note && <p class="step-note">{step.note}</p>}
                </div>
                <figure class:list={['step-screen', { wide: step.wide }]}>
                  <Image src={step.screen} alt={step.alt} widths={step.wide ? [480, 720, 960] : [320, 480, 640]} sizes={step.wide ? '(max-width: 1000px) 100vw, 34rem' : '(max-width: 1000px) 18rem, 20rem'} format="webp" quality={80} />
                </figure>
              </li>
            ))
          }
        </ol>
        <p class="screens-note">Screens from the RevX app · demo accounts</p>
      </div>
    </section>

    <!-- Practical questions, from the same list as /faq -->
    <section id="questions">
      <div class="wrap">
        <header class="sec-head">
          <h2>The practical bits.</h2>
        </header>
        <dl class="qa">
          {
            homeFaq.map(({ q, a }) => (
              <div>
                <dt>{q}</dt>
                <dd>{a}</dd>
              </div>
            ))
          }
        </dl>
        <p class="more"><a href="/faq">More questions</a></p>
      </div>
    </section>

    <!-- 4. Roadmap -->
    <section id="vision" class="vision">
      <div class="wrap">
        <header class="sec-head">
          <h2>Roadmap: lamps we haven't wired yet.</h2>
          <p class="lede">Where RevX is headed. None of this works in the app today.</p>
        </header>
        <ul class="unwired" aria-label="Roadmap, not built">
          {
            roadmap.map((r) => (
              <li>
                <span class="dead"><Icon name={r.icon} size={20} /></span>
                <span>{r.name}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="route-head">The road to launch.</h3>
        <ol class="route">
          {
            milestones.map((m) => (
              <li class={m.state} aria-current={m.state === 'now' ? 'step' : undefined}>
                <span class="stop" aria-hidden="true">
                  {m.state === 'done' && <Icon name="check" size={18} />}
                  {m.state === 'now' && <Icon name="pin" size={18} />}
                </span>
                <span class="stop-name">{m.name}</span>
                <span class="stop-state">{stateLabel[m.state]}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 6. Close -->
    <section class="close">
      <div class="wrap close-inner">
        <div>
          <h2>Your car's telling you something.</h2>
          <p class="lede">Find out what, and who should fix it. Runs in your browser today; iOS and Android are coming.</p>
        </div>
        <div class="close-actions">
          <a class="start" href={APP_URL}>
            <span class="start-main">Open</span>
            <span class="start-sub">RevX</span>
          </a>
        </div>
      </div>
    </section>
  </main>

</Base>

<style>
  /* Journey: copy and screen side by side, alternating sides down the page. */
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .step:nth-child(even) .step-copy {
    order: 2;
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
  }

  .step-copy p:not(.step-num) {
    margin-top: 0.75rem;
    max-width: 44ch;
    color: var(--body);
    font-size: 1.125rem;
  }

  .step-copy .step-note {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .step-screen {
    margin: 0;
    justify-self: center;
    width: min(100%, 20rem);
  }

  .step-screen.wide {
    width: min(100%, 34rem);
  }

  .step-screen img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 1.5rem;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 24px 36px -24px var(--shadow);
  }

  .screens-note {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* Practical questions */
  .qa {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem 3rem;
  }

  .qa div {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .qa dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--heading);
  }

  .qa dd {
    margin: 0.5rem 0 0;
    color: var(--body);
  }

  .more {
    margin-top: 2rem;
  }

  /* Roadmap */
  .vision {
    background: var(--sand);
  }

  .unwired {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 1.25rem 2rem;
  }

  .unwired li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .dead {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1.5px dashed var(--muted);
    background: var(--sand);
    color: var(--muted);
  }

  /* Roadmap route: milestones on one wire, solid where travelled, dashed ahead. */
  .route-head {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: 1.75rem;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
  }

  .route {
    --stop: 2.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .route li {
    position: relative;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    align-content: start;
  }

  /* The wire to the next stop. */
  .route li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--stop) / 2);
    left: calc(var(--stop) + 0.5rem);
    right: -0.5rem;
    border-top: 1.5px dashed var(--unlit);
  }

  .route li.done::after {
    border-top: 1.5px solid var(--accent-text);
  }

  .stop {
    display: grid;
    place-items: center;
    width: var(--stop);
    height: var(--stop);
    margin-bottom: 0.4rem;
    border-radius: 50%;
    border: 1.5px dashed var(--unlit);
    background: var(--sand);
  }

  .done .stop {
    border: 1.5px solid var(--accent-text);
    color: var(--accent-text);
  }

  .now .stop {
    border: 1.5px solid var(--accent-text);
    background: var(--accent);
    color: var(--on-accent);
  }

  .stop-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.1;
    color: var(--heading);
  }

  .next .stop-name {
    color: var(--muted);
  }

  .stop-state {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .now .stop-state {
    color: var(--accent-text);
  }

  /* Close */
  .close {
    background: radial-gradient(ellipse at 80% 130%, var(--accent-wash), transparent 60%);
  }

  .close-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem 4rem;
  }

  .close h2 {
    font-size: clamp(2.5rem, 5.5vw, 5rem);
  }

  .close-actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  @media (max-width: 1000px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
    }

    .step:nth-child(even) .step-copy {
      order: 0;
    }

    .close-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The route turns vertical: stops stack and the wire runs down the left. */
    .route {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .route li {
      grid-template-columns: var(--stop) minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 0.1rem;
      align-items: center;
    }

    .route .stop {
      grid-row: span 2;
      margin-bottom: 0;
    }

    .route li:not(:last-child)::after {
      top: calc(var(--stop) + 0.25rem);
      bottom: -1.25rem;
      left: calc(var(--stop) / 2);
      right: auto;
      border-top: 0;
      border-left: 1.5px dashed var(--unlit);
    }

    .route li.done::after {
      border-top: 0;
      border-left: 1.5px solid var(--accent-text);
    }

  }

  @media (max-width: 640px) {
    .unwired {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .unwired li {
      font-size: 1rem;
      line-height: 1.2;
    }

    .close-actions {
      flex-wrap: wrap;
    }
  }
</style>
