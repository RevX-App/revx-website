---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ferrariHero from '../assets/heroes/ferrari-hero.jpeg';
import Icon from '../components/Icon.astro';
import { CONTACT_EMAIL, PHONE } from '../config';

// Approved 2026-11-25. No traction numbers until they're real.
const pitchRows = [
  { name: 'The problem', body: "Car owners can't tell what's wrong or what's fair, and good independent mechanics struggle to find customers." },
  { name: 'The model', body: 'Free during launch. A commission comes later, once in-app payments and escrow are live.' },
  { name: 'Where we are', body: "The app is live in the browser, and we're onboarding founding mechanics around UC San Diego." },
  { name: 'Who we are', body: 'Five UC San Diego students who built the app in-house, with a start from The Basement @ UCSD.' },
];
---

<Base title="Contact" description="Get help with the RevX app, or email the founders about investing, press or partnerships.">
  <PageHead title="Contact" lede="Help with the app, or a direct line to the founders." photo={ferrariHero} focus="50% 62%" />
  <main>
    <section id="help">
      <div class="wrap">
        <header class="sec-head">
          <h2>Need help with the app?</h2>
          <p class="lede">
            Account questions, bugs, reports and account deletion are on our <a href="/support">support page</a>.
          </p>
          <p class="lede">Mechanics with questions can call or text <a href={`tel:${PHONE.tel}`}>{PHONE.display}</a>.</p>
        </header>
      </div>
    </section>

    <!-- For investors: the plan in four lines, then the shared inbox below -->
    <section id="investors">
      <div class="wrap split">
        <header class="sec-head">
          <h2>For investors</h2>
          <p class="lede">We're raising now. Email us below to set up a call.</p>
        </header>
        <dl class="pitch">
          {
            pitchRows.map((r) => (
              <div>
                <dt>{r.name}</dt>
                <dd>{r.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- 6. Contact: straight to the founders' shared inbox -->
    <section id="contact">
      <div class="wrap split contact">
        <header class="sec-head">
          <h2>Investing, press, partners?</h2>
          <p class="lede">Email us directly; a founder reads every message.</p>
        </header>

        <figure class="panel-glass">
          <div class="msg-screen">
            <p class="msg-head">Incoming · founders' line</p>
            <ul class="lines">
              <li>
                <span class="line-who">RevX founders</span>
                <a class="line-mail" href={`mailto:${CONTACT_EMAIL}`}>
                  {CONTACT_EMAIL}
                </a>
                <button class="btn btn-ghost copy" type="button" data-copy={CONTACT_EMAIL}>
                  <span class="copy-lamp" aria-hidden="true">
                    <Icon name="check" size={16} />
                  </span>
                  <span data-copy-label>Copy email</span>
                </button>
              </li>
            </ul>
          </div>
          <p class="sr-only" aria-live="polite" data-copy-status />
        </figure>
      </div>
    </section>
  </main>
</Base>
<script>
  // Copy the founders' email; the lamp lights only on a click, per the no-autonomous-motion rule.
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
      } catch {
        // Clipboard blocked: the address stays a mailto link, so say so instead of failing silently.
        label.textContent = 'Select to copy';
        return;
      }
      btn.classList.add('is-copied');
      label.textContent = 'Copied';
      if (status) status.textContent = `Copied ${btn.dataset.copy}`;
    });
  });
</script>

<style>
  #help .sec-head {
    margin-bottom: 0;
  }

  .pitch {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .pitch div {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .pitch dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--heading);
  }

  .pitch dd {
    margin: 0;
    color: var(--body);
  }

  /* Contact: the message centre, one line per founder. */
  .contact {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
  }

  .contact .sec-head {
    margin-bottom: 0;
  }

  .msg-screen {
    padding: 1.1rem 1.2rem;
    border-radius: 0.9rem;
    border: 1px solid var(--rule);
    background: var(--bg);
  }

  .msg-head {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lines li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .lines li:last-child {
    border-bottom: 0;
    padding-bottom: 0.2rem;
  }

  .line-who {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .line-mail {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    line-height: 1.15;
    color: var(--accent-text);
    text-decoration: none;
  }

  .line-mail:hover {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .copy {
    min-height: 2.75rem;
    padding: 0.4rem 1rem 0.4rem 0.45rem;
    font-size: 1rem;
  }

  .copy-lamp {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 1.5px solid var(--unlit);
    background: var(--sand);
    color: transparent;
    transition:
      background 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .copy.is-copied .copy-lamp {
    border-color: var(--accent-text);
    background: var(--accent);
    color: var(--on-accent);
  }

  @media (max-width: 640px) {
    .pitch div {
      grid-template-columns: minmax(0, 1fr);
    }

    .lines li {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
  }
</style>
